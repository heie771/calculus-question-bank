            {
              "id": 6,
              "type": "fill_in",
              "answer": "$-\\frac{1}{2}\\cos 2x+C$",
              "question": "$\\sin 2x\\,dx=\\mathrm{d}(\\underline{\\qquad})$。",
              "solution": [
                {
                  "type": "text",
                  "text": "解析：$\\because  (\\cos 2x+C)'=-\\sin 2x\\cdot (2x)'=-2\\sin 2x$"
                },
                {
                  "type": "text",
                  "text": "$\\therefore  (-\\frac{1}{2}\\cos 2x+C)'=\\sin 2x$，故 $\\sin 2x\\,dx=\\mathrm{d}(-\\frac{1}{2}\\cos 2x+C)$。"
                }
              ]
            }
          ]
        },
        {
          "title": "二、单项选择题",
          "questions": [
            {
              "id": 7,
              "type": "single_choice",
              "answer": "C",
              "options": {
                "A": "$f(x)$ 在 $[a,b]$ 上的最大值一定是极大值",
                "B": "$f(x)$ 在 $(a,b)$ 内的极值点一定是驻点",
                "C": "若 $x_0$ 是 $f(x)$ 的驻点，$x_0$ 一定不是 $f(x)$ 的间断点",
                "D": "若 $f'(x_0)=f''(x_0)=0$，$f(x_0)$ 一定不是极值"
